APP_ENV=development
PORT=3000
APP_PASSWORD=
COOKIE_SECURE=false

DATABASE_URL=sqlite:///./data/database/uniai.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=10

# Imposta qui il percorso del vault Obsidian sul server.
OBSIDIAN_VAULT_PATH=./obsidian-vault
OBSIDIAN_NOTES_SUBDIR=Università/Lezioni
# Facoltativo: cartelle che contengono una sottocartella per ogni materia.
# Esempio per questo vault: uni/Uni/triennale,uni/Uni/magistrale
OBSIDIAN_SUBJECT_ROOTS=
# Cartella in cui creare automaticamente una nuova materia.
OBSIDIAN_NEW_SUBJECT_ROOT=uni/Uni/triennale
# Sottocartella allegati creata dentro la cartella di ogni materia.
OBSIDIAN_SUBJECT_ATTACHMENTS_SUBDIR=Allegati
AUTO_SAVE_TO_VAULT=false
ALLOW_CREATE_MISSING_WIKILINKS=false

# mock | gemini | openai | openai-compatible | openrouter | ollama
AI_PROVIDER=mock
# Per Gemini usa ad esempio: gemini-3.8-flash
AI_MODEL=gemini-3.8-flash
AI_API_KEY=
AI_BASE_URL=
AI_JSON_MODE=true

# Fallback automatico: se il modello primario è incerto o fallisce, riprova con un modello più potente.
AI_FALLBACK_ENABLED=true
AI_FALLBACK_PROVIDER=gemini
AI_FALLBACK_MODEL=gemini-3.1-pro-preview
AI_FALLBACK_MIN_CONFIDENCE=0.7
AI_FALLBACK_ON_ILLEGIBLE=true
AI_FALLBACK_MIN_CHARS_PER_IMAGE=80
# Facoltativi: se vuoti usano AI_API_KEY e AI_BASE_URL.
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
WORKER_POLL_MS=1500

# Sincronizzazione WebDAV per Obsidian Mobile + plugin Remotely Save.
# Imposta una password robusta e usa HTTPS se esponi il server su Internet.
WEBDAV_ENABLED=false
WEBDAV_PATH=/webdav
WEBDAV_USERNAME=uniai
WEBDAV_PASSWORD=
WEBDAV_MAX_UPLOAD_MB=50

# HTTPS diretto Node.js (opzionale). In alternativa usa Caddy/Nginx.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Retry automatici per errori transitori Gemini e copertura multi-immagine.
AI_RETRY_MAX_ATTEMPTS=8
AI_RETRY_BASE_DELAY_MS=2000
AI_RETRY_MAX_DELAY_MS=30000

# Alternativa vision OpenAI-compatible: DeepSeek Flash
# AI_PROVIDER=deepseek
# AI_MODEL=deepseek-flash
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=
# Per usarlo come fallback:
# AI_FALLBACK_PROVIDER=deepseek
# AI_FALLBACK_MODEL=deepseek-flash
# AI_FALLBACK_BASE_URL=https://api.deepseek.com
# AI_FALLBACK_API_KEY=

# Limite output per provider OpenAI-compatible. Per DeepSeek Flash il default è 32768.
AI_MAX_OUTPUT_TOKENS=


# Claude Haiku 5.5 primario + Sonnet 5.5 per precisione, via Message Batches (-50%).
AI_PROVIDER=claude
AI_MODEL=claude-haiku-5-5
AI_BASE_URL=https://api.anthropic.com
AI_API_KEY=
AI_JSON_MODE=true
AI_MAX_OUTPUT_TOKENS=32768
AI_CLAUDE_USE_BATCH=true
AI_CLAUDE_BATCH_POLL_MS=10000
AI_CLAUDE_BATCH_TIMEOUT_MS=21600000
AI_FALLBACK_ENABLED=true
AI_FALLBACK_PROVIDER=claude
AI_FALLBACK_MODEL=claude-sonnet-5-5
AI_FALLBACK_BASE_URL=https://api.anthropic.com
AI_FALLBACK_API_KEY=
AI_FALLBACK_MIN_CONFIDENCE=0.7
AI_FALLBACK_ON_ILLEGIBLE=true
AI_FALLBACK_MIN_CHARS_PER_IMAGE=80
# Fallback di emergenza se Claude non è configurato o non risponde.
AI_EMERGENCY_ENABLED=true
AI_EMERGENCY_PROVIDER=deepseek
AI_EMERGENCY_MODEL=deepseek-flash
AI_EMERGENCY_BASE_URL=https://api.deepseek.com
AI_EMERGENCY_API_KEY=


# Ottimizzazione immagini prima dell'invio all'AI.
IMAGE_MAX_SIDE=1600
IMAGE_JPEG_QUALITY=88
IMAGE_CROP_ENABLED=true
IMAGE_CROP_ANALYSIS_SIDE=640
IMAGE_CROP_THRESHOLD=24
IMAGE_CROP_PADDING_RATIO=0.02
IMAGE_CROP_MAX_INK_LOSS_RATIO=0.02
IMAGE_CROP_MIN_CONTENT_RATIO=0.08
